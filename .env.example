# Where the Spring Boot backend runs. Only used by the Vite dev proxy.
VITE_PROXY_TARGET=http://localhost:8080

# Leave empty in dev (requests go through the proxy).
# In production set it to the API origin if it differs from the site, e.g. https://api.aeroscale.com
VITE_API_BASE_URL=https://aerosale.onrender.com
